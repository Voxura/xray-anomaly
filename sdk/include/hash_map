#pragma once
#include <unordered_map>

namespace stdext {
    template <typename K, typename Less = std::less<K>>
    struct hash_compare {
        size_t operator()(const K& key) const { return std::hash<K>()(key); }
        bool operator()(const K& k1, const K& k2) const { return Less()(k1, k2); }
    };

    template <typename K, typename V, typename Traits = hash_compare<K>, typename Alloc = std::allocator<std::pair<const K, V>>>
    using hash_map = std::unordered_map<K, V>;

    template <typename K, typename V, typename Traits = hash_compare<K>, typename Alloc = std::allocator<std::pair<const K, V>>>
    using hash_multimap = std::unordered_multimap<K, V>;
}
